@@ -0,0 +1,131 @@
+﻿import { setImmediate as setImmediatePromise } from "node:timers/promises";
+import { promisify } from "node:util";
+
+const nativeSetImmediate = globalThis.setImmediate;
+const nativeSetImmediatePromise = setImmediatePromise;
+
+const REQUEST_CONTEXT = Symbol.for("__cloudflare-context__");
+const NEXT_ORIGINALS = Symbol.for("next.fast-set-immediate.originals");
+
+const scopes = new WeakMap();
+
+const scopeOutsideRequest = {
+    scheduledImmediates: 0,
+    lastRender: Promise.resolve(),
+};
+
+function currentScope() {
+    const context = globalThis[REQUEST_CONTEXT];
+
+    if (typeof context !== "object" || context === null) {
+        return scopeOutsideRequest;
+    }
+
+    let scope = scopes.get(context);
+
+    if (!scope) {
+        scope = {
+            scheduledImmediates: 0,
+            lastRender: Promise.resolve(),
+        };
+
+        scopes.set(context, scope);
+    }
+
+    return scope;
+}
+
+function countedSetImmediate(callback, ...args) {
+    currentScope().scheduledImmediates++;
+
+    return nativeSetImmediate(callback, ...args);
+}
+
+const countedSetImmediatePromise = (value, options) => {
+    currentScope().scheduledImmediates++;
+
+    return nativeSetImmediatePromise(value, options);
+};
+
+Object.defineProperty(countedSetImmediate, promisify.custom, {
+    value: countedSetImmediatePromise,
+});
+
+globalThis.setImmediate = countedSetImmediate;
+
+const nextOriginals = globalThis[NEXT_ORIGINALS];
+
+if (nextOriginals) {
+    nextOriginals.setImmediate = countedSetImmediate;
+}
+
+export function runInSequentialTasks(first, ...rest) {
+    const scope = currentScope();
+    const previousRender = scope.lastRender;
+
+    let endRender;
+
+    scope.lastRender = new Promise((resolve) => {
+        endRender = resolve;
+    });
+
+    return new Promise((resolve, reject) => {
+        const stages = [first, ...rest];
+        let result;
+
+        const fail = (error) => {
+            endRender();
+            reject(error);
+        };
+
+        const afterImmediates = (next) => {
+            const scheduled = scope.scheduledImmediates;
+
+            nativeSetImmediate(() => {
+                if (scope.scheduledImmediates === scheduled) {
+                    next();
+                } else {
+                    afterImmediates(next);
+                }
+            });
+        };
+
+        const runStage = (index) => {
+            try {
+                const value = stages[index]();
+
+                if (index === 0) {
+                    result = value;
+
+                    if (isThenable(result)) {
+                        result.then(noop, noop);
+                    }
+                }
+            } catch (error) {
+                fail(error);
+                return;
+            }
+
+            afterImmediates(() => {
+                if (index + 1 < stages.length) {
+                    runStage(index + 1);
+                } else {
+                    endRender();
+                    resolve(result);
+                }
+            });
+        };
+
+        void previousRender.then(() => {
+            nativeSetImmediate(() => runStage(0));
+        });
+    });
+}
+
+function isThenable(value) {
+    return value !== null &&
+        typeof value === "object" &&
+        typeof value.then === "function";
+}
+
+function noop() {}
